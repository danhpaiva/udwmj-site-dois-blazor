@page "/sorteio"
@rendermode InteractiveServer

<h3>Sorteador de Números</h3>

<button class="btn btn-success mb-3" @onclick="SorteiaNumero">Gerar Número Aleatório</button>

@if (numeroSorteado.HasValue)
{
    <h2>Número Sorteado: <span class="badge bg-secondary">@numeroSorteado</span></h2>
}

@code {
    private int? numeroSorteado;
    private Random random = new Random();

    private void SorteiaNumero()
    {
        numeroSorteado = random.Next(1, 101); // Gera um número entre 1 e 100
    }
}