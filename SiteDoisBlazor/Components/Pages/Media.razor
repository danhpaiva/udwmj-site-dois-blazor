@page "/media"
@rendermode InteractiveServer

<h3>Calculadora de Média</h3>

<div class="mb-3">
    <label class="form-label">Primeira Nota:</label>
    <input type="number" step="0.1" class="form-control" @bind="nota1" style="max-width: 300px;" />
</div>

<div class="mb-3">
    <label class="form-label">Segunda Nota:</label>
    <input type="number" step="0.1" class="form-control" @bind="nota2" style="max-width: 300px;" />
</div>

<button class="btn btn-primary mb-3" @onclick="CalcularMedia">Calcular Média</button>

@if (media.HasValue)
{
    <div class="alert @(media >= 7.0 ? "alert-success" : "alert-danger")" style="max-width: 300px;">
        <p class="mb-1"><strong>Média Final:</strong> @media.Value.ToString("F1")</p>
        <p class="mb-0"><strong>Status:</strong> @(media >= 7.0 ? "Aprovado!" : "Reprovado!")</p>
    </div>
}

@code {
    private double nota1;
    private double nota2;
    private double? media;

    private void CalcularMedia()
    {
        media = (nota1 + nota2) / 2;
    }
}